PKGs="binutils gcc glibc linux"

function build {
n=1 # Start exit at 2
for i in $*
do
	(echo "==== $i ===="; cd $i
	 sed -i '/^BIN_DATE/ cBIN_DATE=oct 23 2026$' *.info
	 sed -i '/^COMPILE/ cCOMPILE=linux 5.4, glibc 2.31, gcc 9.5.0, binutils 2.34$' *.info
		bash BUILD) \
			|| n="$(expr $n + 1)" exit $n
done
unset n i
}

build $PKGs
